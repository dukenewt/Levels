rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: users can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Top-level tasks: enforce ownership via userId field
    match /tasks/{taskId} {
      allow read, write: if isOwner(resource) || isOwner(request.resource);
    }

    // User subcollections: /users/{uid}/tasks/{id}, /users/{uid}/epics/{id}
    match /users/{userId}/{collectionName}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId && validateOwnershipOnWrite();
    }

    // Epics top-level (if used): enforce ownership
    match /epics/{epicId} {
      allow read, write: if isOwner(resource) || isOwner(request.resource);
    }

    function isOwner(doc) {
      return request.auth != null && doc.data.userId == request.auth.uid;
    }

    function validateOwnershipOnWrite() {
      return request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}

